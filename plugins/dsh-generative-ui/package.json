{
  "name": "@deepseek-ai/dsh-generative-ui",
  "version": "0.2.2-rc.1",
  "description": "Built-in generative UI for DeepSeek Harness: the agent writes TSX, the web and desktop surfaces render it in an isolated frame, inline in chat and in a right-sidebar canvas",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/sandbox/sandbox.html",
    "skill",
    "types",
    "!types/deps",
    "!types/generated",
    "!types/check.ts",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "generative-ui",
    "genui",
    "ui4a",
    "artifacts",
    "canvas",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "react",
    "tsx",
    "streaming",
    "ai-agents",
    "llm"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown --config-loader native",
    "typecheck": "tsc -b tsconfig.json",
    "check:dependency-types": "node scripts/generate-dependency-types.mjs --check",
    "gen:standalone": "bun scripts/gen-standalone.ts",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "lint": "oxlint src test scripts eval website types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:declarations": "tsc -p tsconfig.types-check.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@esm.sh/tsx": "^1.5.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-util-workspace-path": "workspace:*",
    "@unocss/core": "^66.8.1",
    "@unocss/preset-wind4": "^66.8.1",
    "partial-react": "~0.0.10",
    "partial-tsx": "~0.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.23.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MindLab-Research/dsh-generative-ui.git"
  },
  "homepage": "https://github.com/MindLab-Research/dsh-generative-ui#readme",
  "bugs": {
    "url": "https://github.com/MindLab-Research/dsh-generative-ui/issues"
  }
}
